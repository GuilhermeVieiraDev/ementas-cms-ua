{
  "name": "ementas-cms-ua",
  "version": "1.0.0",
  "description": "Monorepo for the UA canteen menus scraper API.",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @ementas/api",
    "build:api": "npm run build --workspace @ementas/api",
    "start:api": "npm run start --workspace @ementas/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC"
}
